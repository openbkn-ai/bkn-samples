    {
      "metric_name": "未关闭预测单数",
      "scope_ref": "supply_ontology_hand_forecast",
      "aggregation": {
        "property": "id",
        "aggr": "count"
      },
      "time_property": null,
      "caliber": "全量主数据或当前订单状态",
      "supported_modes": [
        "instant",
        "proportion"
      ],
      "analysis_dimensions": [
        "material_number",
        "closestatus_title"
      ],
      "period_filter_supported": false,
      "temporal_proportion_supported": false,
      "required_query_condition": {
        "field": "closestatus_title",
        "operation": "!=",
        "value": "已关闭"
      },
      "default_range_policy": "none",
      "note": "未关闭口径须显式传关闭状态过滤；空请求不算业务正确。"
    },
