{
  "schema_version": "1.0",
  "comment": "样例文档与验收契约；不是平台 API 的新字段，安装器不提交此文件。既有指标同名 create 不更新，按开发指南发布新版本并干净重装。",
  "metrics": [
    {
      "metric_name": "产品总数",
      "scope_ref": "supply_ontology_hand_product",
      "aggregation": {
        "property": "material_number",
        "aggr": "count"
      },
      "time_property": null,
      "caliber": "全量主数据或当前订单状态",
      "supported_modes": [
        "instant"
      ],
      "analysis_dimensions": [],
      "period_filter_supported": false,
      "temporal_proportion_supported": false,
      "required_query_condition": null,
      "default_range_policy": "none",
      "note": "没有历史时间语义，不应按入库日或截止日伪造趋势。"
    },
    {
      "metric_name": "物料总数",
      "scope_ref": "supply_ontology_hand_material",
      "aggregation": {
        "property": "material_code",
        "aggr": "count"
      },
      "time_property": null,
      "caliber": "全量主数据或当前订单状态",
      "supported_modes": [
        "instant",
        "proportion"
      ],
      "analysis_dimensions": [
        "materialattr",
        "group_name"
      ],
      "period_filter_supported": false,
      "temporal_proportion_supported": false,
      "required_query_condition": null,
      "default_range_policy": "none",
      "note": "没有历史时间语义，不应按入库日或截止日伪造趋势。"
    },
