    {
      "metric_name": "按签约日期的签约数量",
      "scope_ref": "supply_ontology_hand_salesorder",
      "aggregation": {
        "property": "signing_quantity",
        "aggr": "sum"
      },
      "time_property": "signing_date",
      "caliber": "签约事件日期",
      "supported_modes": [
        "instant",
        "trend",
        "sameperiod",
        "proportion"
