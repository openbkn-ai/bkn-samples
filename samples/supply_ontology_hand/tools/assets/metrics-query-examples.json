{
  "comment": "可直接作为 openbkn bkn metric query --body 的查询体。metric_id 由脚本按 metric_name 解析。仓预设已在各 case 展开，不要对 analysis_dimensions 做全量分组验收（平台约只回 20 组）。",
  "kn_id": "supply_ontology_hand",
  "warehouse_scope_presets": {
    "production_available": [
      "苏州半成品仓",
      "苏州成品仓",
      "苏州电子原料仓",
      "苏州无人机原料仓",
      "苏州装配原料仓",
      "乌鲁木齐成品仓",
      "哈尔滨成品仓"
    ],
    "finished_goods": [
      "苏州成品仓",
      "乌鲁木齐成品仓",
      "哈尔滨成品仓"
    ],
    "all": []
  },
  "cases": [
    {
      "id": "product_count",
      "metric_name": "产品总数",
      "title": "成品种数",
      "body": {},
      "expected_value": 30
    },
    {
      "id": "material_count",
      "metric_name": "物料总数",
      "title": "物料种数",
      "body": {},
      "expected_value": 3497
    },
    {
      "id": "material_purchased",
      "metric_name": "物料总数",
      "title": "外购物料种数",
      "body": {
        "condition": { "field": "materialattr", "operation": "==", "value": "外购" }
      },
      "expected_value": 3149
    },
    {
      "id": "supplier_count",
      "metric_name": "供应商总数",
      "title": "供应商家数",
      "body": {},
      "expected_value": 230
    },
    {
      "id": "supplier_yang",
      "metric_name": "供应商总数",
      "title": "采购员杨强云名下供应商",
      "body": {
        "condition": { "field": "purchaserid_name", "operation": "==", "value": "杨强云" }
      },
      "expected_value": 51
    },
    {
      "id": "salesorder_count",
      "metric_name": "销售订单数",
      "title": "销售订单张数",
      "body": {},
      "expected_value": 800
    },
    {
      "id": "salesorder_382",
      "metric_name": "销售订单数",
      "title": "382-000005 销售订单张数",
      "body": {
        "condition": { "field": "product_code", "operation": "==", "value": "382-000005" }
      },
      "expected_value": 40
    },
    {
      "id": "warehouse_count",
      "metric_name": "仓库数",
      "title": "库存出现过的仓库去重",
      "body": {},
      "expected_value": 29
    },
    {
      "id": "inv_382_fg",
      "metric_name": "库存可用量",
      "title": "382-000005 成品仓可用",
      "body": {
        "condition": {
          "operation": "and",
          "sub_conditions": [
            { "field": "material_code", "operation": "==", "value": "382-000005" },
            {
              "field": "warehouse",
              "operation": "in",
              "value": ["苏州成品仓", "乌鲁木齐成品仓", "哈尔滨成品仓"]
            }
          ]
        }
      },
      "expected_value": 534,
      "note": "平台支持 and + sub_conditions 时用本 body；若报 UnsupportConditionOperation，分次查询再交。"
    },
    {
      "id": "inv_791_prod",
      "metric_name": "库存可用量",
      "title": "791-000013 生产可用仓",
      "body": {
        "condition": {
          "operation": "and",
          "sub_conditions": [
            { "field": "material_code", "operation": "==", "value": "791-000013" },
            {
              "field": "warehouse",
              "operation": "in",
              "value": [
                "苏州半成品仓",
                "苏州成品仓",
                "苏州电子原料仓",
                "苏州无人机原料仓",
                "苏州装配原料仓",
                "乌鲁木齐成品仓",
                "哈尔滨成品仓"
              ]
            }
          ]
        }
      },
      "expected_value": 1000
    },
    {
      "id": "forecast_qty_all",
      "metric_name": "预测需求量合计",
      "title": "预测数量全量",
      "body": {},
      "expected_value": 115922
    },
    {
      "id": "forecast_382_open_qty",
      "metric_name": "预测需求量合计",
      "title": "382-000005 未关闭预测数量",
      "body": {
        "condition": {
          "operation": "and",
          "sub_conditions": [
            { "field": "material_number", "operation": "==", "value": "382-000005" },
            { "field": "closestatus_title", "operation": "==", "value": "正常" }
          ]
        }
      },
      "expected_value": 2605
    },
    {
      "id": "open_forecast_count",
      "metric_name": "未关闭预测单数",
      "title": "未关闭预测单张数",
      "body": {
        "condition": { "field": "closestatus_title", "operation": "!=", "value": "已关闭" }
      },
      "expected_value": 90,
      "note": "定义态 condition 无效。查询时必须显式传 closestatus_title != 已关闭。"
    }
  ]
}
