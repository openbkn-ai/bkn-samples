{
  "comment": "安装连通性查询探针，不含冻结期望值或答案。数值正确性必须使用维护者独立数据库复算及源仓库bkn-eval/fixtures/metric-verification另行验证。",
  "kn_id": "supply_ontology_hand",
  "warehouse_scope_presets": {
    "production_available": [
      "苏州半成品仓",
      "苏州成品仓",
      "苏州电子原料仓",
      "苏州无人机原料仓",
      "苏州装配原料仓",
      "乌鲁木齐成品仓",
      "哈尔滨成品仓"
    ],
    "finished_goods": [
      "苏州成品仓",
      "乌鲁木齐成品仓",
      "哈尔滨成品仓"
    ],
    "all": []
  },
  "cases": [
    {
      "id": "product_count",
      "metric_name": "产品总数",
      "title": "成品种数",
      "body": {}
    },
    {
      "id": "material_count",
      "metric_name": "物料总数",
      "title": "物料种数",
      "body": {}
    },
    {
      "id": "material_purchased",
      "metric_name": "物料总数",
      "title": "外购物料种数",
      "body": {
        "condition": {
          "field": "materialattr",
          "operation": "==",
          "value": "外购"
        }
      }
    },
    {
      "id": "supplier_count",
      "metric_name": "供应商总数",
      "title": "供应商家数",
      "body": {}
    },
    {
      "id": "supplier_yang",
      "metric_name": "供应商总数",
      "title": "采购员杨强云名下供应商",
      "body": {
        "condition": {
          "field": "purchaserid_name",
          "operation": "==",
          "value": "杨强云"
        }
      }
    },
    {
      "id": "salesorder_count",
      "metric_name": "销售订单数",
      "title": "销售订单张数",
      "body": {}
    },
    {
      "id": "salesorder_382",
      "metric_name": "销售订单数",
      "title": "382-000005 销售订单张数",
      "body": {
        "condition": {
          "field": "product_code",
          "operation": "==",
          "value": "382-000005"
        }
      }
    },
    {
      "id": "warehouse_count",
      "metric_name": "仓库数",
      "title": "库存出现过的仓库去重",
      "body": {}
    },
    {
      "id": "inv_382_fg",
      "metric_name": "库存可用量",
      "title": "382-000005 成品仓可用",
      "body": {
        "condition": {
          "operation": "and",
          "sub_conditions": [
            {
              "field": "material_code",
              "operation": "==",
              "value": "382-000005"
            },
            {
              "field": "warehouse",
              "operation": "in",
              "value": [
                "苏州成品仓",
                "乌鲁木齐成品仓",
                "哈尔滨成品仓"
              ]
            }
          ]
        }
      },
      "note": "平台支持 and + sub_conditions 时用本 body；若报 UnsupportConditionOperation，分次查询再交。"
    },
    {
      "id": "inv_791_prod",
      "metric_name": "库存可用量",
      "title": "791-000013 生产可用仓",
      "body": {
        "condition": {
          "operation": "and",
          "sub_conditions": [
            {
              "field": "material_code",
              "operation": "==",
              "value": "791-000013"
            },
            {
              "field": "warehouse",
              "operation": "in",
              "value": [
                "苏州半成品仓",
                "苏州成品仓",
                "苏州电子原料仓",
                "苏州无人机原料仓",
                "苏州装配原料仓",
                "乌鲁木齐成品仓",
                "哈尔滨成品仓"
              ]
            }
          ]
        }
      }
    },
    {
      "id": "forecast_qty_all",
      "metric_name": "预测需求量合计",
      "title": "预测数量全量",
      "body": {}
    },
    {
      "id": "forecast_382_open_qty",
      "metric_name": "预测需求量合计",
      "title": "382-000005 未关闭预测数量",
      "body": {
        "condition": {
          "operation": "and",
          "sub_conditions": [
            {
              "field": "material_number",
              "operation": "==",
              "value": "382-000005"
            },
            {
              "field": "closestatus_title",
              "operation": "==",
              "value": "正常"
            }
          ]
        }
      }
    },
    {
      "id": "open_forecast_count",
      "metric_name": "未关闭预测单数",
      "title": "未关闭预测单张数",
      "body": {
        "condition": {
          "field": "closestatus_title",
          "operation": "!=",
          "value": "已关闭"
        }
      }
    }
  ]
}
