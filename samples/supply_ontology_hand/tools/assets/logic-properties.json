{
  "comment": "指标创建之后，按 metric_name 解析平台 id，挂到 scope 对象类的 logic_properties。平台要求 metric.scope_ref == 对象类 id，不能跨对象挂。类级规模指标无实例参数；库存/预测/订单用对象属性作过滤维。系统会自动补 instant/start/end/step，写入时不要带。",
  "kn_id": "supply_ontology_hand",
  "bindings": [
    {
      "object_type_id": "supply_ontology_hand_product",
      "logic_properties": [
        {
          "name": "product_total_count",
          "display_name": "产品总数",
          "type": "metric",
          "metric_name": "产品总数",
          "comment": "类级：成品种数。数值请用 metric query；逻辑属性用于从产品对象发现该指标。",
          "parameters": []
        }
      ]
    },
    {
      "object_type_id": "supply_ontology_hand_material",
      "logic_properties": [
        {
          "name": "material_total_count",
          "display_name": "物料总数",
          "type": "metric",
          "metric_name": "物料总数",
          "comment": "类级：物料种数。可按物料属性 / 存货类别过滤。",
          "parameters": [
            {
              "name": "materialattr",
              "type": "string",
              "value_from": "input",
              "operation": "==",
              "comment": "物料属性，如 外购 / 自制 / 委外 / 虚拟"
            },
            {
              "name": "group_name",
              "type": "string",
              "value_from": "input",
              "operation": "==",
              "comment": "存货类别"
            }
          ]
        }
      ]
    },
    {
      "object_type_id": "supply_ontology_hand_supplier",
      "logic_properties": [
        {
          "name": "supplier_total_count",
          "display_name": "供应商总数",
          "type": "metric",
          "metric_name": "供应商总数",
          "comment": "类级：供应商家数。可按采购员过滤。",
          "parameters": [
            {
              "name": "purchaserid_name",
              "type": "string",
              "value_from": "input",
              "operation": "==",
              "comment": "采购员姓名"
            }
          ]
        }
      ]
    },
    {
      "object_type_id": "supply_ontology_hand_salesorder",
      "logic_properties": [
        {
          "name": "sales_order_count",
          "display_name": "销售订单数",
          "type": "metric",
          "metric_name": "销售订单数",
          "comment": "订单张数。实例上用本单 product_code 过滤；也可按订单状态过滤。",
          "parameters": [
            {
              "name": "product_code",
              "type": "string",
              "value_from": "property",
              "value": "product_code",
              "operation": "=="
            },
            {
              "name": "order_status",
              "type": "string",
              "value_from": "input",
              "operation": "==",
              "comment": "订单状态"
            }
          ]
        }
      ]
    },
    {
      "object_type_id": "supply_ontology_hand_inventory",
      "logic_properties": [
        {
          "name": "warehouse_count",
          "display_name": "仓库数",
          "type": "metric",
          "metric_name": "仓库数",
          "comment": "库存记录中仓库去重。不是「生产可用仓个数」。",
          "parameters": [
            {
              "name": "stock_status",
              "type": "string",
              "value_from": "input",
              "operation": "==",
              "comment": "库存状态，如 可用"
            }
          ]
        },
        {
          "name": "available_qty_sum",
          "display_name": "库存可用量",
          "type": "metric",
          "metric_name": "库存可用量",
          "comment": "sum(available_inventory_qty)。仓范围在查询时用 warehouse in 展开预设，不要写进指标定义。",
          "parameters": [
            {
              "name": "material_code",
              "type": "string",
              "value_from": "property",
              "value": "material_code",
              "operation": "=="
            },
            {
              "name": "warehouse",
              "type": "string",
              "value_from": "input",
              "operation": "in",
              "comment": "仓库列表；成品仓或生产可用仓预设在此展开"
            },
            {
              "name": "stock_status",
              "type": "string",
              "value_from": "input",
              "operation": "==",
              "comment": "库存状态，缺省常为 可用"
            }
          ]
        }
      ]
    },
    {
      "object_type_id": "supply_ontology_hand_forecast",
      "logic_properties": [
        {
          "name": "forecast_qty_sum",
          "display_name": "预测需求量合计",
          "type": "metric",
          "metric_name": "预测需求量合计",
          "comment": "sum(qty)。未关闭请再滤 closestatus_title。",
          "parameters": [
            {
              "name": "material_number",
              "type": "string",
              "value_from": "property",
              "value": "material_number",
              "operation": "=="
            },
            {
              "name": "closestatus_title",
              "type": "string",
              "value_from": "input",
              "operation": "==",
              "comment": "关闭状态。未关闭用 正常 或 != 已关闭"
            }
          ]
        },
        {
          "name": "open_forecast_count",
          "display_name": "未关闭预测单数",
          "type": "metric",
          "metric_name": "未关闭预测单数",
          "comment": "定义态 condition 会被平台丢弃。查询时必须带 closestatus_title != 已关闭 或 == 正常。",
          "parameters": [
            {
              "name": "material_number",
              "type": "string",
              "value_from": "property",
              "value": "material_number",
              "operation": "=="
            },
            {
              "name": "closestatus_title",
              "type": "string",
              "value_from": "input",
              "operation": "!=",
              "comment": "关闭状态；未关闭请传 已关闭 + operation !="
            }
          ]
        }
      ]
    }
  ]
}
