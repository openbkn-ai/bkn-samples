        "locations": [
          "https://github.com/openbkn-ai/bkn-samples/releases/download/sample-supply-chain-en-v0.1.1/package.tar.gz"
        ]
      },
      {
        "id": "database-image",
        "type": "oci-image",
        "digest": "sha256:08b7233ab1d0c1976e0a49c968e4fc31867a2a15b5c40725d2817036dbd3e306",
        "locations": [
          "oci://ghcr.io/openbkn-ai/bkn-samples"
        ]
      }
