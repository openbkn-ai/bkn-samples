        }
      ]
    },
    "requires": {
      "architectures": [
        "arm64",
        "amd64"
      ],
      "capabilities": [
        "vega.catalog",
        "knowledge-network.import.kn-json",
        "execution.function",
        "execution.skill"
      ],
      "installationProfiles": [
        "openbkn.ai/sample-install.v1"
