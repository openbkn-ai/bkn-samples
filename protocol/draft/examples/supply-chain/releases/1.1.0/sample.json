{
  "apiVersion": "samples.openbkn.ai/v1beta1",
  "kind": "Sample",
  "metadata": {
    "sampleId": "supply-chain",
    "version": "1.1.0",
    "displayName": "供应链",
    "summary": "用脱敏的订单、库存、BOM 和供应数据体验交付判断。",
    "authors": [
      "OpenBKN"
    ],
    "licenseNote": "脱敏历史回放，不能用于真实交付承诺。"
  },
  "spec": {
    "release": {
      "publishedAt": "2026-10-09T00:00:00Z",
      "defaultLocale": "zh-CN",
      "releaseNotes": [
        {
          "locale": "zh-CN",
          "path": "release-notes.zh-CN.md",
          "digest": "sha256:116f3d9b068689b1c1f94b272cfba22d6e71b3f7a086c475441f1e395f60bed4"
        }
      ]
    },
    "requires": {
      "platformVersion": ">=0.2.0 <0.2.1",
      "capabilities": [
        "vega.catalog",
        "knowledge-network.import.kn-json",
        "execution.function",
        "execution.skill"
      ],
      "architectures": [
        "amd64",
        "arm64"
      ],
      "requiredExtensions": [],
      "installationProfiles": [
        "openbkn.ai/sample-install.v1"
      ]
    },
    "artifacts": [
      {
        "id": "package",
        "type": "archive",
        "digest": "sha256:5a9b9f580333a677c992da0c9d50f740cbd1dfa382633f0b2e333c641b8ecc8f",
        "locations": [
          "https://releases.openbkn.invalid/supply-chain/1.1.0/package.tar.gz"
        ]
      },
      {
        "id": "database-image",
        "type": "oci-image",
        "digest": "sha256:5c686e6842fffcd97c9f5cd5970e89e8a1ab0efd37063ee4d1d3b9a95e6274b6",
        "locations": [
          "oci://registry.openbkn.invalid/supply-chain-data"
        ]
      }
    ],
    "experience": [
      {
        "type": "openbkn.ai/knowledge-network-detail.v1",
        "questions": [
          "这批需求能不能按当前库存和在制满足？",
          "缺料时有哪些可用替代料？"
        ],
        "contentId": "supply-network"
      }
    ],
    "extensions": {},
    "contents": {
      "knowledgeNetworks": [
        {
          "artifactId": "package",
          "directory": "kn/supply_ontology_hand",
          "format": "kn-json",
          "entrypoint": "supply_ontology_hand.json",
          "contentId": "supply-network"
        }
      ],
      "functionPackages": [
        {
          "artifactId": "package",
          "directory": "functions",
          "contentId": "supply-functions"
        }
      ],
      "skillPackages": [
        {
          "artifactId": "package",
          "directory": "skills",
          "contentId": "supply-skills"
        }
      ]
    },
    "delivery": {
      "profile": "openbkn.ai/sample-install.v1",
      "dataDependencies": [
        {
          "id": "supply-data",
          "artifactId": "database-image",
          "engine": "mariadb",
          "databaseName": "supply_demo_hand",
          "expectedTables": 12
        }
      ],
      "bindings": [
        {
          "objectTypeId": "supply_ontology_hand_inventory",
          "dataDependencyId": "supply-data",
          "tableName": "inventory",
          "contentId": "supply-network"
        }
      ]
    }
  }
}
