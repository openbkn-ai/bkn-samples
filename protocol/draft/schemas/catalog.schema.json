{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openbkn.invalid/draft/catalog.schema.json",
  "title": "OpenBKN catalog draft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "samples.openbkn.ai/v1beta1"
    },
    "kind": {
      "const": "SampleCatalog"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "channel": {
          "enum": [
            "stable",
            "development"
          ]
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "sourceId",
        "revision",
        "sequence",
        "channel",
        "publishedAt"
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sampleId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "publishedAt": {
                "type": "string",
                "format": "date-time"
              },
              "releaseStatus": {
                "enum": [
                  "published",
                  "withdrawn"
                ]
              },
              "releaseNotes": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "defaultLocale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "documents": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "locale": {
                          "type": "string",
                          "minLength": 1
                        },
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "pattern": "^https://"
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "locale",
                        "url",
                        "digest"
                      ]
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "defaultLocale",
                  "summary",
                  "documents"
                ]
              },
              "manifest": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "url",
                  "digest"
                ]
              },
              "requires": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "platformVersion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "architectures": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "amd64",
                        "arm64"
                      ]
                    },
                    "minItems": 1
                  },
                  "requiredExtensions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  },
                  "installationProfiles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "platformVersion",
                  "capabilities",
                  "architectures",
                  "requiredExtensions",
                  "installationProfiles"
                ]
              },
              "verification": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "url",
                  "digest"
                ]
              },
              "withdrawalReason": {
                "type": "string",
                "minLength": 1
              },
              "extensions": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}/[a-zA-Z0-9._-]+$"
                }
              }
            },
            "required": [
              "sampleId",
              "version",
              "displayName",
              "summary",
              "publishedAt",
              "releaseStatus",
              "releaseNotes",
              "manifest",
              "requires",
              "verification"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "releaseStatus": {
                      "const": "withdrawn"
                    }
                  }
                },
                "then": {
                  "required": [
                    "withdrawalReason"
                  ]
                }
              }
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "entries"
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}/[a-zA-Z0-9._-]+$"
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ]
}
